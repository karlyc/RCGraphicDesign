      {
        "selector": "JSXOpeningElement[name.name='TurnaroundOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|shipsBy|price|selected|recommended|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TurnaroundOption> doesn't accept that prop. Declared props: name, shipsBy, price, selected, recommended, onClick, style."
      }
    ]
